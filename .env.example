# Copy this file to .env and replace the values. .env is ignored by git, never commit it.
#   cp .env.example .env

# --- NCBI E-utilities (etl.download_pubmed_xml) -------------------------------
# Optional but recommended: raises the limit from 3 to 10 requests per second.
# Create a key at https://account.ncbi.nlm.nih.gov/settings/ (API Key Management).
NCBI_API_KEY=your_ncbi_api_key
# NCBI asks for a contact email with every request.
NCBI_EMAIL_ADDRESS=you@example.com

# --- Postgres (etl.load_pubmed_to_postgres) -----------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/clinical_qa

# --- Tests ---------------------------------------------------------------------
# Throwaway database for tests/load_pubmed_to_postgres_test.py. The test DROPS and
# recreates the articles, authors and mesh_terms tables, so never point this at
# the DATABASE_URL database. Leave it unset to skip that one test.
TEST_DATABASE_URL=postgresql://postgres:change_me@localhost:5432/clinical_qa_test
